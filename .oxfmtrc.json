{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 80,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "all",
	"ignorePatterns": [
		"node_modules/**",
		".next/**",
		"out/**",
		"build/**",
		"coverage/**",
		"public/theme-previews/**",
		"src/app/api/preview/fonts/**",
		"api-reference/health.mdx",
		"bun.lock",
		"pnpm-lock.yaml"
	]
}
